# App Configuration
PORT=8080
NODE_ENV=production
TRUST_PROXY_HOPS=1
CLIENT_ORIGIN=https://your-frontend-domain.com
PUBLIC_API_ORIGIN=https://your-backend-api.com

# Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname

# JWT Secrets (use high-entropy random strings)
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-32-characters
JWT_EXPIRE=30m

# Email Configuration (for OTP and Contact Us messages)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Arcjet Security (required in production)
ARCJET_KEY=your-arcjet-key
ARCJET_ENV=production

# ImageKit Media Storage (required in production)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Cashfree Payment Gateway (Get from Cashfree Merchant Dashboard: Developers -> API Keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01
