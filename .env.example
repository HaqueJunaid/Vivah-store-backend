# App Configuration
PORT=8080
NODE_ENV=production
CLIENT_ORIGIN=https://your-frontend-domain.com

# Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname

# JWT Secrets (use high-entropy random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRE=24h

# Email Configuration (for OTP and Contact Us messages)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Arcjet Security (Optional, blank/omitted will fallback to disabled)
ARCJET_KEY=your-arcjet-key
ARCJET_ENV=production

# ImageKit Media Storage (Optional, blank/omitted will disable uploads)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
